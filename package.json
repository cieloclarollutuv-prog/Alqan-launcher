{
  "name": "alqan-launcher",
  "version": "2.10.0",
  "description": "Alqan Launcher - launcher de Minecraft moderno, abierto y multiplataforma",
  "main": "main.js",
  "author": "Alqan Launcher contributors",
  "license": "MIT",
  "homepage": "https://github.com/alqan/alqan-launcher",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "minecraft-launcher-core": "^3.18.2",
    "tar": "^6.2.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.alqan.launcher",
    "productName": "Alqan Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Alqan Launcher",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "language": "3082",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "artifactName": "Alqan-Launcher-Setup-${version}.exe",
      "include": "build/installer.nsh",
      "warningsAsErrors": false,
      "uninstallDisplayName": "Alqan Launcher",
      "menuCategory": false,
      "displayLanguageSelector": false
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "target": [
        "AppImage",
        "tar.gz"
      ]
    },
    "afterPack": "build/afterPack.js",
    "portable": {
      "artifactName": "Alqan-Launcher-Portable-${version}.exe"
    }
  }
}